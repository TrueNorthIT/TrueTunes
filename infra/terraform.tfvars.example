# Copy to terraform.tfvars (git-ignored) or export as TF_VAR_<name>. Never commit real values.
entra_tenant_id = "00000000-0000-0000-0000-000000000000"
entra_client_id = "00000000-0000-0000-0000-000000000000"
auth_enforce    = "false"

# Secrets: prefer environment variables so they stay out of files.

# Optional integrations, baked into the bundle (EXPO_PUBLIC_*), like the desktop's build-env.json.
# Azure Functions base URL (defaults to the shared truetunes-fn app)
# EXPO_PUBLIC_PUBSUB_FUNCTION_URL=https://truetunes-fn.azurewebsites.net
# Genius lyrics/artist bios; features quietly disable when unset
EXPO_PUBLIC_GENIUS_ACCESS_TOKEN=
# Application Insights telemetry; a complete no-op when unset
EXPO_PUBLIC_APPINSIGHTS_CONNECTION_STRING=

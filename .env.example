APPINSIGHTS_CONNECTION_STRING=

# Fine-grained GitHub token for the feedback dialog: Repository access = TrueNorthIT/TrueTunes only,
# Permissions = Issues: Read and write. Server-side only: read by `server/scripts/deploy.mjs` and
# passed to ARM as `githubIssuesToken`, so it never ships in the installer.
GITHUB_ISSUES_TOKEN=

# Entra sign-in for the desktop app (baked into the build), and the tenant/audience the Azure
# Functions check caller tokens against (passed to ARM by `server/scripts/deploy.mjs`).
ENTRA_CLIENT_ID=
ENTRA_TENANT_ID=

# Transitional: 'true' makes the Azure Functions reject requests without a token. Leave unset
# (= false) until every desktop client sends one, then set it and redeploy the server.
AUTH_ENFORCE=

# Vestaboard Read/Write API key for the office board (Queuedle announcements + leaderboard).
# Read by `server/scripts/deploy.mjs` and passed to ARM as the `vestaboardApiKey` parameter.
# Leave blank to disable Vestaboard messages.
VESTABOARD_API_KEY=

# Genius API access token for song descriptions in the lyrics panel.
# Get one at https://genius.com/api-clients — create a client, copy the Client Access Token.
# Leave blank to disable Genius descriptions.
GENIUS_ACCESS_TOKEN=

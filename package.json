{
  "name": "truetunes",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present && npm run lint:server",
    "lint:server": "eslint -c apps/desktop/eslint.config.mjs server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:run": "npm run test:run --workspaces --if-present",
    "desktop": "npm run dev -w apps/desktop",
    "mobile": "npm start -w apps/mobile"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "@tanstack/react-query": "5.104.0",
    "@types/react": "19.2.18"
  }
}

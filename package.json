{
  "name": "true-tunes-2",
  "version": "1.0.76",
  "description": "Sonos Web Player proxy app",
  "repository": "https://github.com/TrueNorthIT/TrueTunes",
  "author": {
    "name": "True North IT",
    "email": "jpitts@truenorthit.co.uk",
    "url": "https://truenorthit.co.uk"
  },
  "main": "dist/main.js",
  "scripts": {
    "build:main": "tsc && node -e \"require('dotenv').config();const fs=require('fs');fs.copyFileSync('src/debug-ws.html','dist/debug-ws.html');fs.copyFileSync('src/debug-http.html','dist/debug-http.html');fs.writeFileSync('dist/build-env.json',JSON.stringify({GENIUS_ACCESS_TOKEN:process.env.GENIUS_ACCESS_TOKEN||'',APPINSIGHTS_CONNECTION_STRING:process.env.APPINSIGHTS_CONNECTION_STRING||'',ENTRA_CLIENT_ID:process.env.ENTRA_CLIENT_ID||'',ENTRA_TENANT_ID:process.env.ENTRA_TENANT_ID||''}))\"",
    "build:native": "node-gyp rebuild --directory native/smtc",
    "build:renderer": "vite build --config renderer/vite.config.ts",
    "build": "npm run build:main && npm run build:renderer",
    "dev:renderer": "vite --config renderer/vite.config.ts",
    "dev": "npm run build:main && concurrently -k \"npm run dev:renderer\" \"electron . --remote-debugging-port=9333\"",
    "start": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && npm run build:native && electron-builder --win",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:publish:win": "npm run build && npm run build:native && electron-builder --win --publish always",
    "test": "vitest --config renderer/vitest.config.ts",
    "test:ui": "vitest --config renderer/vitest.config.ts --ui",
    "test:run": "vitest run --config renderer/vitest.config.ts",
    "test:coverage": "vitest run --config renderer/vitest.config.ts --coverage",
    "storybook": "storybook dev -p 6006 -c renderer/.storybook",
    "build-storybook": "storybook build -c renderer/.storybook -o storybook-static",
    "lint": "npm run lint:eslint && npm run lint:css && npm run lint:design",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,css}\"",
    "typecheck": "tsc --noEmit && tsc --noEmit --project renderer/tsconfig.json",
    "test:main": "node --test src/**/*.test.ts scripts/**/*.test.mjs",
    "lint:eslint": "eslint .",
    "lint:css": "stylelint \"renderer/src/**/*.css\"",
    "lint:design": "npx -y -p @google/design.md@0.4.0 designmd lint DESIGN.md"
  },
  "dependencies": {
    "@azure/msal-node": "^7.1.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.22",
    "applicationinsights": "^3.17.0",
    "dompurify": "^3.4.17",
    "dotenv": "^18.0.9",
    "electron-updater": "^6.8.11",
    "marked": "^18.1.1",
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mediapipe/tasks-vision": "1.1.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-vitest": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@tanstack/react-query": "^5.104.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.3",
    "liquid-glass-react": "^1.1.1",
    "lucide-react": "^1.61.0",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^13.1.0",
    "pixelmatch": "^8.0.0",
    "playwright": "1.64.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "storybook": "10.6.3",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@azure/identity": {
      "@azure/msal-node": "$@azure/msal-node"
    }
  },
  "build": {
    "appId": "uk.co.truenorthit.truetunes",
    "productName": "True Tunes",
    "copyright": "Copyright © 2026 True North IT",
    "publish": {
      "provider": "github",
      "owner": "TrueNorthIT",
      "repo": "TrueTunes"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": true,
      "resetAdHocDarwinSignature": true
    },
    "asarUnpack": [
      "native/smtc/build/Release/smtc.node"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "renderer/dist/**",
      "native/smtc/build/Release/smtc.node",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/taskbar",
        "to": "assets/taskbar"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "verifyUpdateCodeSignature": false,
      "signtoolOptions": {
        "publisherName": "True North IT"
      }
    },
    "nsis": {
      "guid": "com.truenorthit.truetunes",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "True Tunes"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.png",
      "category": "public.app-category.music"
    }
  }
}

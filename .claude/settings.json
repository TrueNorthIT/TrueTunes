{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "PowerShell(npm run *)",
      "Bash(npm ci *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx vitest *)",
      "PowerShell(npx vitest *)",
      "Bash(grep *)",
      "Bash(git show *)",
      "Bash(git check-ignore *)",
      "PowerShell(gh pr view --json number,title,url,state)",
      "PowerShell(Get-Command *)",
      "WebFetch(domain:github.com)",
      "Bash(curl -s http://localhost:9333/json/version)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)"]
  }
}

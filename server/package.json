{
  "name": "true-tunes-server",
  "version": "1.0.0",
  "description": "Azure Functions — office presence features for true-tunes-2",
  "main": "dist/{**/,}*.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "npm run build && func start",
    "prestart": "npm run build",
    "deploy": "node scripts/deploy.mjs",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/shared/*.test.js dist-test/lib/*.test.js",
    "sim:queuedle": "tsc -p tsconfig.sim.json && node dist-test/sim/scripts/sim-queuedle.js",
    "sim:dj": "tsc -p tsconfig.test.json && node scripts/sim-dj.mjs"
  },
  "dependencies": {
    "@azure/cosmos": "^4.1.0",
    "@azure/functions": "^4.5.0",
    "@azure/storage-blob": "^12.26.0",
    "@azure/web-pubsub": "^1.1.3",
    "jose": "^6.2.13"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}

{
  "compilerOptions": {
    // Emits CommonJS (no "type": "module"). jose 6 is ESM-only, so require('jose') needs require(esm): Node >= 20.19.
    "module": "node20",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/**/*.testkit.ts"]
}
